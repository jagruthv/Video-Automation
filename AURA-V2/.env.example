# AURA-V2 Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AI: Script Generation (Required) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI: LLM Fallback Chain (Optional) ─────────────────────────────────────────
# Comma-separated model priority list
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
LLM_PRIORITY=gemini-2.5-flash,gemini-3.1-flash-lite-preview,llama-3.3-70b-versatile

# ── AI: Image Generation (Optional) ───────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here   # Free at pixabay.com/api/docs/ — used for background music
BYOP_TOKEN=your_pollinations_byop_token_here
# Options: gemini-imagen | pollinations | pexels
PROVIDERS_ENABLED=pollinations,pexels

# ── AI: Voice Synthesis (Optional) ────────────────────────────────────────────
# GPU Fish Speech server endpoint
FISH_SPEECH_URL=http://localhost:7860
# Edge TTS fallback voice
EDGE_TTS_VOICE=en-US-ChristopherNeural

# ── YouTube / Google (Required for publishing) ─────────────────────────────────
YT_CLIENT_ID=your_yt_client_id_here
YT_CLIENT_SECRET=your_yt_client_secret_here
YT_REFRESH_TOKEN=                        # Run: pnpm yt-auth to generate this

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Milliseconds between pipeline stages (default: 15000)
STAGE_COOLDOWN_MS=15000

# ── Background Video ──────────────────────────────────────────────────────────
# Default mode when none specified: gaming | sand | pinterest
BG_VIDEO_MODE=gaming

# ── Auth / SaaS (Disabled by default) ─────────────────────────────────────────
# Set to 'true' to enable JWT auth, rate limiting, and plan gates
AUTH_ENABLED=false
# Secret key for signing JWTs (change this to a long random string in production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
